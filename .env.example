# Скопировать в .env. Значения ниже рассчитаны на `make up` и работают без правок.
# Держим файл коротким намеренно: в прототипе .env.example дорос до 12 КБ и перестал читаться.

DATABASE_URL=postgres://survey:survey@localhost:5432/survey
REDIS_URL=redis://localhost:6379

# Адрес, от которого строятся ссылки на анкету, когда у портала не задан свой хост.
PUBLIC_BASE_URL=http://localhost:3000

# Приложение в партнёрском кабинете Битрикс24. Без этой пары установка не проходит:
# подтвердить, что грант действительно от этого портала, можно только переавторизацией.
B24_CLIENT_ID=
B24_CLIENT_SECRET=

# Ключ шифрования токенов портала: 32 байта в base64 или hex.
# Сгенерировать: openssl rand -base64 32
TOKEN_ENC_KEY=

LOG_LEVEL=debug
