{
  // Проект ТОЛЬКО для линта: корневые конфиги сборки и бутстрап телеметрии не входят ни в один
  // tsconfig (ядровой покрывает src/test/scripts, нуксовые — app/server), и без этого файла они
  // выпадали из линта МОЛЧА — ESLint пропускает несовпавший путь без предупреждения и с кодом 0.
  // `allowJs` нужен ради `otel.instrument.mjs`: это прод-путь (грузится через NODE_OPTIONS=--import
  // в образе) и он весь про промисы, то есть ровно предмет этого гейта. `checkJs` НЕ включаем —
  // типизировать чистый JS мы не собираемся, нужен лишь доступ к типам для правил.
  "extends": "./tsconfig.json",
  "compilerOptions": { "allowJs": true, "checkJs": false },
  "include": ["*.config.ts", "*.config.mjs", "otel.instrument.mjs", "scripts/**/*.mjs"],
  "exclude": []
}
