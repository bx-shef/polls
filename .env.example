# Скопировать в .env. Значения ниже рассчитаны на `make up` и работают без правок.
# Держим файл коротким намеренно: в прототипе .env.example дорос до 12 КБ и перестал читаться.

DATABASE_URL=postgres://survey:survey@localhost:5432/survey
REDIS_URL=redis://localhost:6379

# Адрес, от которого строятся ссылки на анкету, когда у портала не задан свой хост.
PUBLIC_BASE_URL=http://localhost:3000

# Приложение в партнёрском кабинете Битрикс24. Без этой пары установка не проходит:
# подтвердить, что грант действительно от этого портала, можно только переавторизацией.
B24_CLIENT_ID=
B24_CLIENT_SECRET=

# Ключ шифрования токенов портала: 32 байта в base64 или hex.
# Сгенерировать: openssl rand -base64 32
B24_TOKEN_ENC_KEY=

# Прежний ключ — только на время ротации. Без него подмена B24_TOKEN_ENC_KEY мгновенно
# делает нечитаемым каждый сохранённый токен, то есть каждый портал должен переустановить
# приложение. Убирается, когда из логов пропадёт предупреждение «расшифрован ПРЕЖНИМ ключом».
# B24_TOKEN_ENC_KEY_OLD=

# Разбор буфера ответов. `off` выключает его в этом процессе — понадобится, когда доставку
# вынесут в отдельный контейнер. По умолчанию включено: забытая переменная не должна
# означать «ответы копятся и никто не везёт».
# ANSWER_DELIVERY=off
# ANSWER_DELIVERY_INTERVAL=60

LOG_LEVEL=debug

# ─── Живые проверки против тестового портала ──────────────────────────────────
# Кладутся в ОТДЕЛЬНЫЙ файл `.env.b24test` — его подхватывает `pnpm verify:*`.
# Отдельный он затем, чтобы проверка, которая ПИШЕТ на портал, не могла случайно
# подхватить боевое окружение: адрес портала при этом всё равно виден в команде.
#
#   DATABASE_URL=postgres://...      та же база, что у запущенного приложения
#   PUBLIC_BASE_URL=https://...      адрес, который попадёт в ссылку (только https)
#
#   pnpm verify:link --hook https://ПОРТАЛ/rest/1/КЛЮЧ/ --deal 2
#   pnpm verify:link --hook ... --deal 2 --base http://localhost:3000
