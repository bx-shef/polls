# Прод-окружение для /home/bitrix/polls/.env.prod на сервере. НЕ коммитить.

# Домен приложения (A-запись → сервер). По нему nginx-proxy маршрутизирует и выпускает TLS.
DOMAIN=polls.example.com

# Email для Let's Encrypt. Нужен ТОЛЬКО при первом подъёме общего прокси (make init-nginxproxy)
# на чистом сервере; если прокси уже запущен — не используется (email задан глобально в acme).
LETSENCRYPT_EMAIL=admin@example.com

# Секрет HMAC-сессии дашборда контура B и handshake app-фрейма (>= 32). openssl rand -hex 32.
# Без него прод-дашборд fail-closed (503) — PII клиентов не утечёт.
DASHBOARD_AUTH_SECRET=REPLACE_WITH__openssl_rand_hex_32

# Ключ шифрования OAuth-токенов Bitrix24 в БД (AES-256-GCM, 64 hex). openssl rand -hex 32.
# Нужен при связке с порталом (хранение токенов).
NUXT_BITRIX_TOKEN_KEY=REPLACE_WITH__openssl_rand_hex_32

# PostgreSQL (#6, постоянное хранение). Пароль БД — задайте сильный.
# DATABASE_URL приложение собирает из него в compose (postgres://polls:...@db:5432/polls).
# Миграции применяются приложением на старте; данные — в volume db-data (переживают рестарт).
POSTGRES_PASSWORD=REPLACE_WITH_strong_password

# OAuth-приложение портала (client_id/secret из настроек приложения Bitrix24) — нужны для установки
# на портал и для фонового рефреша токенов. Без них связка с порталом не поднимется.
NUXT_B24_CLIENT_ID=
NUXT_B24_CLIENT_SECRET=

# ── Поведение приложения (всё опционально; без значений — дефолты приложения) ──

# Какой опрос запускать по сделке / по умолчанию (встроенный дефолт — csat_postdeal).
# SURVEY_KEY_DEAL=csat_postdeal
# SURVEY_KEY_DEFAULT=csat_postdeal
# Как часто освежать OAuth-токены, часы (дефолт 24, диапазон 1–168).
# TOKEN_KEEPALIVE_HOURS=24
# Уровень логов: debug | info | warn | error (невалидное значение молча падает на info).
# NUXT_LOG_LEVEL=info

# ── Авто-триггер: каким путём запускать опрос при доходе сделки до стадии ──
# ⚠️ Режим применяется ПРИ УСТАНОВКЕ приложения: после смены значения приложение нужно переустановить
#    на портале, иначе старая привязка останется, а новая не появится — авто-триггер замолчит.
# Каким путём запускать опрос, когда сделка доходит до стадии:
#   event (по умолчанию) — событие ONCRMDEALUPDATE + подтверждение перехода историей стадий.
#                          Любой тариф. ⚠️ Даёт дубли: правки идут гроздью вокруг перехода
#                          (дозаполнение обязательных полей, автоматизация стадии) — реалистично
#                          2–4 приглашения на один переход.
#   robot                 — робот автоматизации: ровно на входе в стадию, дублей нет.
#                          Нужен тариф с бизнес-процессами. Рекомендуется, если тариф позволяет.
#   both                  — оба. Полезной настройки сегодня не даёт (вне триггер-стадии робот молчит,
#                          на триггер-стадии — дубль); оставлено на переходный период.
# TRIGGER_MODE=event
# Окно «переход был только что» для пути event, секунды (дефолт 60, диапазон 5–3600).
# STAGE_ENTRY_WINDOW_SECONDS=60

# Кому ещё разрешено встраивать приложение в iframe (директива CSP frame-ancestors).
# Облачные зоны Bitrix24 (bitrix24.ru/.com/.by/.kz/…) разрешены и без настройки — сюда добавляют
# self-hosted и box-порталы. Через запятую или пробел, только https:
# CSP_FRAME_ANCESTORS=https://crm.acme.local
